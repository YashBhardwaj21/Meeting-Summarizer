# === Secrets (do NOT commit actual values) ===
GROQ_API_KEY=
OPENAI_API_KEY=

# === App ===
APP_NAME="Meeting Summarizer"
DEBUG=False
CORS_ORIGINS='["http://localhost:3000"]'

# === Database ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/meeting_summarizer

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Object Storage (MinIO locally, R2 in production)
STORAGE_INTERNAL_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=meetings
STORAGE_REGION=us-east-1

# === File limits ===
MAX_FILE_SIZE_BYTES=2147483648
PRESIGN_EXPIRY_SECONDS=900

# === ASR ===
ASR_PROVIDER=local
ASR_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
ASR_CHUNK_DURATION_SECONDS=300
ASR_CHUNK_OVERLAP_SECONDS=15
ASR_CONCURRENCY=4
ASR_TIMEOUT_SECONDS=120
ASR_MAX_RETRIES=3

# === Diarization ===
DIARIZATION_ENABLED=false

# === Embeddings ===
EMBEDDING_PROVIDER=nomic
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=3
EMBEDDING_MAX_INPUT_TOKENS=8191

# === LLM ===
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434

# === Chunking ===
TRANSCRIPT_CHUNK_MAX_TOKENS=800
TRANSCRIPT_CHUNK_OVERLAP_TOKENS=80
TOKENIZER_ENCODING=cl100k_base

# === Worker ===
MEDIA_TEMP_DIR=/tmp/meeting-summarizer
PROCESSING_MAX_ATTEMPTS=3
MAX_MEDIA_DURATION_SECONDS=7200
MAX_TEMP_STORAGE_BYTES=5368709120
PROCESSING_PIPELINE_VERSION=2.0
